AddDefaultCharset utf-8
ErrorDocument 404 /
Options -Indexes

# config, sql, tests, tools, docs — браузерден ашылмайды
RewriteEngine On
RewriteRule ^(config|sql|tests|tools|docs)(/|$) - [F,L]
RewriteRule (^|/)\.git - [F,L]
# медиа файлдар тек /media/file.php арқылы (рұқсат тексеріледі)
RewriteRule ^assets/uploads/media(/|$) - [F,L]
